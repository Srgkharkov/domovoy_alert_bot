# Скопируйте в .env и заполните:  cp .env.example .env
# .env в .gitignore — никогда не коммитьте его.

# ── Telegram ────────────────────────────────────────────────
# Токен от @BotFather для @domovoy_alert_bot
TELEGRAM_BOT_TOKEN=

# ID чатов, которым разрешено управлять ботом, через запятую.
# У групп ID отрицательный, например -1001234567890.
# Узнать ID: добавьте бота в чат и отправьте /chatid
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Aqara Open API (developer.aqara.com → Project → App) ────
# Региональный сервер — тот, где зарегистрирован аккаунт Aqara Home:
#   Европа  https://open-ger.aqara.com
#   Россия  https://open-ru.aqara.com
#   США     https://open-usa.aqara.com
#   Китай   https://open-cn.aqara.com
#   Корея   https://open-kr.aqara.com
#   Сингапур https://open-sg.aqara.com
AQARA_API_URL=https://open-ger.aqara.com
AQARA_APP_ID=
AQARA_APP_KEY=
AQARA_KEY_ID=

# Логин (email/телефон), под которым вы зарегистрированы на developer.aqara.com.
# Бесплатный разработчик может авторизовать только свой аккаунт, поэтому устройства
# должны принадлежать ему. На этот адрес придёт код авторизации.
AQARA_ACCOUNT=

# ── Алерты (протечка, низкий заряд) ─────────────────────────
# Куда слать алерты. По умолчанию — во все TELEGRAM_ALLOWED_CHAT_IDS.
# TELEGRAM_ALERT_CHAT_IDS=
# Резервный опрос датчиков протечки (на случай потери push).
ALERT_POLL_INTERVAL=5m

# Aqara Message Push (мгновенные события). Пусто = только опрос.
# Домен (поддомен) с A-записью на VPS. Без подчёркиваний — Let's Encrypt их не принимает.
PUBLIC_DOMAIN=
# Случайная строка — часть URL приёмника: https://PUBLIC_DOMAIN/aqara/push/PUSH_SECRET
# Сгенерировать: openssl rand -hex 24
PUSH_SECRET=

# ── Прочее ──────────────────────────────────────────────────
LOG_LEVEL=info
# Каталог для токенов Aqara. В Docker переопределяется на /data.
# DATA_DIR=./data
